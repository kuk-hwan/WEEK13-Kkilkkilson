#!/bin/sh
# 커밋 제목 검사. 규칙은 AGENTS.md의 "Git 규칙"을 따른다.
# 규칙을 바꾸면 이 파일과 .github/workflows/pr-title.yml을 같이 고친다.

subject=$(grep -v '^#' "$1" | grep -v '^[[:space:]]*$' | head -n 1)

case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

fail() {
  echo "커밋 제목이 규칙에 안 맞아요: $1" >&2
  echo "  지금: $subject" >&2
  echo "  형식: 접두사(범위): 요약   (범위는 선택, 깨지는 변경은 접두사(범위)! )" >&2
  echo "  접두사: feat, fix, docs, refactor, test, chore, ci, perf" >&2
  echo "  예: feat(http): 정적 파일 응답 추가" >&2
  exit 1
}

prefix='^(feat|fix|docs|refactor|test|chore|ci|perf)(\([a-z0-9-]+\))?!?: '

printf '%s\n' "$subject" | grep -Eq "$prefix" ||
  fail "접두사나 범위 형식이 틀렸어요 (범위는 소문자, 숫자, 하이픈)"

summary=$(printf '%s\n' "$subject" | sed -E "s/$prefix//")
[ -n "$summary" ] || fail "요약이 비어 있어요"

# 글자 수로 센다: UTF-8 이어지는 바이트(0x80~0xBF)를 빼고 남은 바이트 수
chars=$(printf '%s' "$summary" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
[ "$chars" -le 50 ] || fail "요약이 ${chars}자예요 (50자 안쪽)"

case "$summary" in
  *.) fail "요약 끝에 마침표를 빼 주세요" ;;
esac

exit 0
